FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential \
        default-libmysqlclient-dev \
        libgl1 \
        libglib2.0-0 \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY web_project/requirements/ ./requirements/
RUN python -m pip install --no-cache-dir -r requirements/prod.txt

COPY web_project/ ./
COPY deploy/entrypoint.sh /usr/local/bin/signflow-entrypoint
RUN chmod 0755 /usr/local/bin/signflow-entrypoint \
    && groupadd --system signflow \
    && useradd --system --gid signflow --home /app signflow \
    && mkdir -p /app/staticfiles /app/media /app/model \
    && chown -R signflow:signflow /app

USER signflow
EXPOSE 8000
ENTRYPOINT ["signflow-entrypoint"]
CMD ["uvicorn", "web_project.asgi:application", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers"]
