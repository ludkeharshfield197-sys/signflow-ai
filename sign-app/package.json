{
  "name": "signflow-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev:h5": "cross-env UNI_INPUT_DIR=src uni",
    "dev:mp-weixin": "cross-env UNI_INPUT_DIR=src uni -p mp-weixin",
    "build:h5": "cross-env UNI_INPUT_DIR=src uni build && node scripts/sync-static-assets.mjs h5",
    "build:mp-weixin": "cross-env UNI_INPUT_DIR=src uni build -p mp-weixin && node scripts/sync-static-assets.mjs mp-weixin",
    "test:unit": "node --test tests/*.test.js",
    "test": "pnpm run test:unit && pnpm run build:h5 && pnpm run build:mp-weixin"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5010520260709002",
    "@dcloudio/uni-components": "3.0.0-5010520260709002",
    "@dcloudio/uni-h5": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5010520260709002",
    "vue": "3.4.21",
    "vue-i18n": "11.4.8"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-automator": "3.0.0-5010520260709002",
    "@dcloudio/uni-cli-shared": "3.0.0-5010520260709002",
    "@dcloudio/uni-stacktracey": "3.0.0-5010520260709002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5010520260709002",
    "@vue/runtime-core": "3.4.21",
    "cross-env": "7.0.3",
    "rollup": "4.62.3",
    "vite": "6.4.3"
  }
}
