# Copy this file to .env and replace every CHANGE_ME value before deployment.
# Use the real HTTPS domain at deployment time; never commit the resulting .env.
DJANGO_SECRET_KEY=CHANGE_ME_use_at_least_64_random_characters
DJANGO_ALLOWED_HOSTS=signflow.example.com
CORS_ALLOWED_ORIGINS=https://signflow.example.com
CSRF_TRUSTED_ORIGINS=https://signflow.example.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0

DB_NAME=signflow
DB_USER=signflow
DB_PASSWORD=CHANGE_ME_database_password
DB_ROOT_PASSWORD=CHANGE_ME_database_root_password

REDIS_PASSWORD=CHANGE_ME_redis_password

MEDIA_STORAGE_BUCKET=signflow-media
MEDIA_STORAGE_ACCESS_KEY=CHANGE_ME_minio_access_key
MEDIA_STORAGE_SECRET_KEY=CHANGE_ME_minio_secret_key_at_least_32_chars
MEDIA_STORAGE_REGION=us-east-1

SIGNFLOW_PORT=8080
LOG_LEVEL=INFO
YOLO_AUTOINSTALL=false
# Optional legacy assistant experiments. These are not used by the SignFlow
# recognition product and must never be committed with real credentials.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
